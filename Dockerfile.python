# ── builder ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir uv

COPY core/pyproject.toml core/
COPY core/src core/src

RUN uv pip install --system --no-cache-dir -e "./core"

# CLI — copiada depois do core já estar instalado
COPY cli/pyproject.toml cli/
COPY cli/src cli/src

# Instala dependências da CLI explicitamente (evita reprocessar file:../core)
RUN uv pip install --system --no-cache-dir "typer>=0.12" "rich>=13.0" "prompt_toolkit>=3.0"

# Remove a referência file:// do pyproject.toml nesta cópia de build — agent-core
# já está instalado acima e o uv não consegue resolver caminhos relativos durante
# o parse de metadata. O arquivo fonte não é alterado.
RUN sed -i '/"agent-core @ file/d' cli/pyproject.toml && \
    uv pip install --system --no-cache-dir --no-deps "./cli"

# ── runtime ──────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

RUN useradd --create-home --shell /bin/bash agent

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=builder /usr/local/bin/uvicorn    /usr/local/bin/uvicorn
COPY --from=builder /usr/local/bin/agent      /usr/local/bin/agent
COPY core/src /app/src

# config.yaml real não é copiado para o container; o from_yaml cai para defaults
# que usam caminhos relativos (core/src/…) que não existem em /app.
# Criamos um config mínimo só com a seção de skills e apontamos CONFIG_PATH para ele.
RUN printf 'skills:\n  skills_dir: /app/src/agent/skills\n  skills_drafts_dir: /app/src/agent/skills/_drafts\n' \
    > /app/docker-config.yaml

ENV PYTHONPATH=/app/src
ENV CONFIG_PATH=/app/docker-config.yaml

USER agent

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "agent.server:app", "--host", "0.0.0.0", "--port", "8000"]

# ── dev (runtime + test deps) ─────────────────────────────────────────────────
FROM runtime AS dev

USER root
RUN pip install --no-cache-dir "pytest>=8.3,<9" "pytest-asyncio>=0.24,<0.26" "pytest-mock>=3.14" "respx>=0.21"
COPY core/tests /app/tests
USER agent

CMD ["uvicorn", "agent.server:app", "--host", "0.0.0.0", "--port", "8000"]
