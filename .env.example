# LLM — Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxx

# LLM — OpenAI (opcional)
OPENAI_API_KEY=

# LLM — OpenRouter (opcional)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://github.com/seu-usuario/seu-repo
OPENROUTER_X_TITLE=meu-agente

# LLM — Ollama (local; Opção A: mesma máquina)
OLLAMA_BASE_URL=http://localhost:11434

# Multi-modelo
DEFAULT_MODEL=anthropic:claude-sonnet-4-7
MODEL_TIMEOUT_S=60
# Fallback chain (vazio = sem fallback). CSV: "ollama:qwen2.5:7b,anthropic:claude-haiku-4-5"
MODEL_FALLBACK_CHAIN=

# Web Search
TAVILY_API_KEY=
BRAVE_API_KEY=

# Database
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agent
POSTGRES_URL=postgresql://agent:changeme@postgres:5432/agent

# Redis
REDIS_URL=redis://redis:6379/0

# Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=   # CSV de chat_ids autorizados. Vazio = aberto (só dev)
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Gateway (Phase 5)
GATEWAY_PORT=3000
GATEWAY_CORE_URL=http://core:8000
GATEWAY_REDIS_URL=redis://redis:6379/0
CORE_URL=http://core:8000            # usado pelo gateway interno
CORE_TIMEOUT_MS=30000
CORE_RETRY_COUNT=3

# Approvals (Phase 5)
ADMIN_USER_ID=
APPROVAL_DEFAULT_TIMEOUT_SECONDS=1800   # 30 min (default)

# Memory (Phase 2)
POSTGRES_DSN=postgresql://agent:changeme@postgres:5432/agent
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_TOKEN_THRESHOLD=8000
MEMORY_KEEP_RECENT=6
MEMORY_CURATOR_MODEL=claude-haiku-4-5-20251001
MEMORY_COMPRESSOR_MODEL=claude-sonnet-4-6-20250514
MEMORY_CURATOR_ENABLED=true
