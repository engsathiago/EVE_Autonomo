# LLM — Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxx

# LLM — OpenAI (opcional)
OPENAI_API_KEY=

# LLM — OpenRouter (opcional)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://github.com/seu-usuario/seu-repo
OPENROUTER_X_TITLE=meu-agente

# LLM — Ollama (suporta local OU Ollama Cloud)
# Para Ollama local (default):
OLLAMA_BASE_URL=http://localhost:11434
# Para Ollama Cloud (ollama.com), use:
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=sua-chave-de-https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Multi-modelo
DEFAULT_MODEL=anthropic:claude-sonnet-4-7
MODEL_TIMEOUT_S=60
# Fallback chain (vazio = sem fallback). CSV: "ollama:qwen2.5:7b,anthropic:claude-haiku-4-5"
MODEL_FALLBACK_CHAIN=

# Web Search
TAVILY_API_KEY=
BRAVE_API_KEY=

# Database
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agent
POSTGRES_URL=postgresql://agent:changeme@postgres:5432/agent

# Redis
REDIS_URL=redis://redis:6379/0

# Channels — Telegram (gateway Node)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=   # CSV de chat_ids autorizados. Vazio = aberto (só dev)

# F12 — Canais Extras (core Python)
CHANNELS_ENABLED=            # CSV opt-in: discord,slack,email (vazio = nenhum)

# Discord
DISCORD_BOT_TOKEN=           # Token do bot (obrigatório se discord em CHANNELS_ENABLED)
DISCORD_GUILD_ID=            # ID do servidor (guild) privado
DISCORD_USER_ALLOWLIST=      # CSV de user_ids autorizados (obrigatório — sem isso o adapter não sobe)
DISCORD_CHANNELS=            # CSV de nomes de canal monitorados (além de DMs e menções)

# Slack
SLACK_APP_TOKEN=             # xapp-... Socket Mode (obrigatório se slack em CHANNELS_ENABLED)
SLACK_BOT_TOKEN=             # xoxb-... (obrigatório se slack em CHANNELS_ENABLED)
SLACK_USER_ALLOWLIST=        # CSV de member_ids autorizados (obrigatório — sem isso o adapter não sobe)

# Email (IMAP IDLE + SMTP)
EMAIL_IMAP_HOST=             # ex: imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=             # ex: smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=                  # endereço do agente
EMAIL_PASS=                  # app password (não senha real da conta)
EMAIL_FROM_ALLOWLIST=        # CSV de endereços autorizados (obrigatório — sem isso o adapter não sobe)

# Aprovações — canais que podem executar /approve e /deny
APPROVAL_CHANNELS=telegram,web   # default: telegram,web. Adicione discord/slack/email com opt-in explícito

# Rate limits (globais para todos os canais)
RATE_LIMIT_PER_USER_PER_MIN=20
RATE_LIMIT_PER_CHANNEL_PER_MIN=120

# Gateway (Phase 5)
GATEWAY_PORT=3000
GATEWAY_CORE_URL=http://core:8000
GATEWAY_REDIS_URL=redis://redis:6379/0
CORE_URL=http://core:8000            # usado pelo gateway interno
CORE_TIMEOUT_MS=30000
CORE_RETRY_COUNT=3

# Approvals (Phase 5)
ADMIN_USER_ID=
APPROVAL_DEFAULT_TIMEOUT_SECONDS=1800   # 30 min (default)

# Memory (Phase 2)
POSTGRES_DSN=postgresql://agent:changeme@postgres:5432/agent
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_TOKEN_THRESHOLD=8000
MEMORY_KEEP_RECENT=6
MEMORY_CURATOR_MODEL=claude-haiku-4-5-20251001
MEMORY_COMPRESSOR_MODEL=claude-sonnet-4-6-20250514
MEMORY_CURATOR_ENABLED=true
